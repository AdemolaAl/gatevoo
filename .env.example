# ── Gatevoo configuration ─────────────────────────────────────────────
# Copy to .env, fill in, then: npm start
# Only PUBLIC wallet info ever goes here. Never a seed phrase or private key.

# Where Gatevoo is reachable (must be https:// in production)
BASE_URL=https://gatevoo.com
PORT=3000
TZ=Africa/Lagos

# 32+ random characters. Encrypts 2FA secrets and webhook secrets at rest.
# Generate:  openssl rand -hex 32     Keep it secret and never change it after going live.
APP_SECRET=

# First run only: creates your owner account. DELETE the password line after the first start.
OWNER_EMAIL=ademolaalameen86@gmail.com
OWNER_NAME=Ejiro
OWNER_PASSWORD=

# Your main workspace (more businesses can be added from the dashboard)
PRIMARY_WORKSPACE=Zedapex
# USDT on TRON (TRC20) receiving address, starts with T
USDT_TRC20_ADDRESS=
# Bitcoin: "exact" = one address below; "fresh" = a new address per checkout from your zpub
BTC_MODE=fresh
BTC_ADDRESS=
BTC_ZPUB=

# 1 = wallets can only be changed here in .env, never from the dashboard (extra safety)
LOCK_WALLETS=0

# Optional: free key from trongrid.io raises TRON rate limits
TRONGRID_API_KEY=

# Payments
INVOICE_TTL_MIN=30
LATE_MATCH_HOURS=24
BTC_CONFIRMATIONS=1
POLL_SECONDS=20
# Fresh-address mode: accept up to this % short (exchange fees). Overpay auto-credit cap for exact mode.
FRESH_TOLERANCE_PCT=1
OVERPAY_MAX_PCT=10

# Websites allowed to show the checkout pop-up (space separated). Recommended in production.
EMBED_ORIGINS=https://joinvoo.com https://replyvoo.com https://spyvoo.com/
# Reverse proxy addresses allowed to pass the visitor's IP (Caddy/Nginx on the same server = default)
TRUSTED_PROXIES=127.0.0.1 ::1

DATA_FILE=./data/gatevoo.json

# Testing only: simulated blockchain. Must be 0 in production.
MOCK_CHAIN=0
